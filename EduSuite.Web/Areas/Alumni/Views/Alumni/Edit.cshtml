@model EduSuite.Services.Models.AlumniGridDto

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Alumni/Views/Shared/_Layout.cshtml";
}
<link href="~/css/all.min.css" rel="stylesheet" />
<style type="text/css">

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.3s;
        }

            .form-group input:focus,
            .form-group select:focus {
                outline: none;
                border-color: #667eea;
            }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .success-message {
        background: #4caf50;
        color: white;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: none;
    }

    h2 {
        margin-bottom: 30px;
        color: #333;
    }

    h3 {
        color: #667eea;
        margin: 30px 0 20px;
    }

        h3:first-of-type {
            margin-top: 0;
        }

    h4 {
        color: #666;
        margin: 20px 0 10px;
    }

</style>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2 id="formTitle" style="margin: 0;">Edit Alumni Information</h2>
    <button class="btn" onclick="window.location.href='@Url.Action("Index", "Dashboard", new { area = "Alumni" })'">
        ← Back to Dashboard
    </button>
</div>
<div id="alumniSuccess" class="success-message"></div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Hidden field for AlumniId -->
    <input type="hidden" asp-for="AlumniId" />

    <h3>Department Information</h3>
    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-building"></i> Department *</label>
            <select asp-for="DepartmentId" required asp-items="ViewBag.Departments">
                <option value="">-- Select Department --</option>
            </select>
            <span asp-validation-for="DepartmentId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-users"></i> Batch *</label>
            <select asp-for="BatchId" required asp-items="ViewBag.Batches">
                <option value="">-- Select Batch --</option>
            </select>
            <span asp-validation-for="BatchId" class="text-danger"></span>
        </div>
    </div>

    <h3>Personal Information</h3>
    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-user"></i> Name *</label>
            <input type="text" asp-for="Name" placeholder="Enter full name" required>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-id-card"></i> RegNo *</label>
            <input type="text" asp-for="RegNo" placeholder="e.g., REG2024001" required>
            <span asp-validation-for="RegNo" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-envelope"></i> MccEmail *</label>
            <input type="email" asp-for="MccEmail" placeholder="example@mcc.edu" required>
            <span asp-validation-for="MccEmail" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-file-signature"></i> NameFromForm *</label>
            <input type="text" asp-for="NameFromForm" placeholder="Name as per official records" required>
            <span asp-validation-for="NameFromForm" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-calendar-alt"></i> Date of Birth *</label>
            <input type="date" asp-for="DateOfBirth" required>
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-at"></i> Personal Email *</label>
            <input type="email" asp-for="PersonalEmail" placeholder="yourname@gmail.com" required>
            <span asp-validation-for="PersonalEmail" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-mobile-alt"></i> Mobile Number *</label>
            <input type="tel" asp-for="MobileNumber" placeholder="10-digit mobile number" required>
            <span asp-validation-for="MobileNumber" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-pray"></i> Religion & Community</label>
            <input type="text" asp-for="ReligionCommunity" placeholder="e.g., Hindu - OC">
            <span asp-validation-for="ReligionCommunity" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-flag"></i> Nationality</label>
            <input type="text" asp-for="Nationality" placeholder="Indian">
            <span asp-validation-for="Nationality" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-fingerprint"></i> Aadhar Number</label>
            <input type="text" asp-for="AadharNo" placeholder="12-digit Aadhar number">
            <span asp-validation-for="AadharNo" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-tint"></i> Blood Group</label>
            <select asp-for="BloodGroup">
                <option value="">Select Blood Group</option>
                <option value="A+">A+</option>
                <option value="A-">A-</option>
                <option value="B+">B+</option>
                <option value="B-">B-</option>
                <option value="AB+">AB+</option>
                <option value="AB-">AB-</option>
                <option value="O+">O+</option>
                <option value="O-">O-</option>
            </select>
            <span asp-validation-for="BloodGroup" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-language"></i> Languages Known</label>
            <input type="text" asp-for="LanguagesKnown" placeholder="e.g., English, Tamil, Hindi">
            <span asp-validation-for="LanguagesKnown" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-heartbeat"></i> Special Health Complaint</label>
            <input type="text" asp-for="SpecialHealthComplaint" placeholder="Any health conditions (if none, type 'None')">
            <span asp-validation-for="SpecialHealthComplaint" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-wheelchair"></i> Physical Disability</label>
            <input type="text" asp-for="PhysicalDisability" placeholder="Any disabilities (if none, type 'None')">
            <span asp-validation-for="PhysicalDisability" class="text-danger"></span>
        </div>
    </div>

    <h3>Academic History</h3>
    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-school"></i> SSLC School Name</label>
            <input type="text" asp-for="SslcSchool" placeholder="Name of your 10th standard school">
            <span asp-validation-for="SslcSchool" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-chart-line"></i> SSLC Marks</label>
            <input type="text" asp-for="SslcMarks" placeholder="Total marks obtained">
            <span asp-validation-for="SslcMarks" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-percent"></i> Sslc Percentage</label>
            <input type="text" asp-for="SslcPercentage" placeholder="e.g., 85.5%">
            <span asp-validation-for="SslcPercentage" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-trophy"></i> Sslc Achievements</label>
            <input type="text" asp-for="SslcAchievements" placeholder="Awards, distinctions, etc.">
            <span asp-validation-for="SslcAchievements" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-bus"></i> Mode Of Conveyance</label>
            <input type="text" asp-for="ModeOfConveyance" placeholder="e.g., Bus, Bike, Hostel">
            <span asp-validation-for="ModeOfConveyance" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-home"></i> Hall Name Room</label>
            <input type="text" asp-for="HallNameRoom" placeholder="Hostel/Hall name and room number">
            <span asp-validation-for="HallNameRoom" class="text-danger"></span>
        </div>
    </div>

    <h3>Guardian Details</h3>
    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-user-shield"></i> Local Guardian Name</label>
            <input type="text" asp-for="LocalGuardianName" placeholder="Name of local guardian">
            <span asp-validation-for="LocalGuardianName" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-phone"></i> Local Guardian Phone</label>
            <input type="tel" asp-for="LocalGuardianPhone" placeholder="10-digit phone number">
            <span asp-validation-for="LocalGuardianPhone" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-signature"></i> Parent Guardian Signature</label>
            <input type="text" asp-for="ParentGuardianSignature" placeholder="Parent/Guardian signature">
            <span asp-validation-for="ParentGuardianSignature" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-exclamation-triangle"></i> Emergency Phone</label>
            <input type="tel" asp-for="EmergencyPhone" placeholder="Emergency contact number">
            <span asp-validation-for="EmergencyPhone" class="text-danger"></span>
        </div>
    </div>

    <h3>Hobbies & Interests</h3>
    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-heart"></i> Hobbies</label>
            <input type="text" asp-for="Hobbies" placeholder="e.g., Reading, Sports, Music">
            <span asp-validation-for="Hobbies" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-star"></i> Extra Curricular Interests</label>
            <input type="text" asp-for="ExtraCurricularInterests" placeholder="e.g., Drama, Debate, Photography">
            <span asp-validation-for="ExtraCurricularInterests" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label><i class="fas fa-briefcase"></i> Interested In PartTime Job</label>
            <input type="text" asp-for="InterestedInPartTimeJob" placeholder="Yes/No">
            <span asp-validation-for="InterestedInPartTimeJob" class="text-danger"></span>
        </div>
    </div>

    <h3>Social Platforms</h3>
    <div class="form-row">
        <div class="form-group">
            <label><i class="fab fa-facebook"></i> Facebook</label>
            <input type="text" asp-for="SocialFacebook" placeholder="Facebook profile URL or username">
            <span asp-validation-for="SocialFacebook" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fab fa-instagram"></i> Instagram</label>
            <input type="text" asp-for="SocialInstagram" placeholder="Instagram handle">
            <span asp-validation-for="SocialInstagram" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label><i class="fab fa-twitter"></i> Twitter</label>
            <input type="text" asp-for="SocialTwitter" placeholder="Twitter handle">
            <span asp-validation-for="SocialTwitter" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label><i class="fas fa-calendar-check"></i> Date Of Signature</label>
            <input type="date" asp-for="DateOfSignature">
            <span asp-validation-for="DateOfSignature" class="text-danger"></span>
        </div>
    </div>

    <!-- Hidden audit fields -->
    <input type="hidden" asp-for="CreatedOn" />
    <input type="hidden" asp-for="CreatedBy" />
    <input type="hidden" asp-for="ModifiedOn" />
    <input type="hidden" asp-for="ModifiedBy" />
    <input type="hidden" asp-for="DepartmentName" />
    <input type="hidden" asp-for="BatchName" />

    <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 30px;">
        <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "Dashboard", new { area = "Alumni" })'">
            <i class="fas fa-times"></i> Cancel
        </button>
        <button type="submit" class="btn">
            <i class="fas fa-save"></i> Update Alumni Information
        </button>
    </div>
</form>

